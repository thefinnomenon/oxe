      "id": "context.team",
      "kind": "context",
      "name": "Team",
      "entity": "entity.team",
      "labelField": "field.team.name",
      "authorization": {
        "kind": "anyOf",
        "anyOf": [
          {
            "kind": "relationEqualsActor",
            "relation": "relation.teamOwner"
          },
          {
            "kind": "membership",
            "membershipEntity": "entity.teamMembership",
            "memberRelation": "relation.membershipMember",
            "resourceRelation": "relation.membershipTeam",
            "conditions": [{ "field": "field.membership.accepted", "equals": true }]
          }
        ]
      }
    },
    {
      "id": "context.ownedTeam",
      "kind": "context",
      "name": "OwnedTeam",
      "entity": "entity.team",
      "labelField": "field.team.name",
      "authorization": {
        "kind": "relationEqualsActor",
        "relation": "relation.teamOwner"
      }
    }
  ],
  "features": [
