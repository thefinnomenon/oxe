    "kind": "app",
    "name": "TinyTodo",
    "entryRoute": "route.tasks",
    "actorEntity": "builtin.user",
    "contexts": ["context.team", "context.ownedTeam"],
    "authentication": {
      "provider": "betterAuth",
      "methods": ["emailPassword"],
      "signInPath": "/sign-in",
      "signUpPath": "/sign-up",
      "authenticatedRoute": "route.tasks"
    }
