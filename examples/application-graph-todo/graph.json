  "queries": [
    {
      "id": "query.myTasks",
      "kind": "query",
      "feature": "feature.tasks",
      "name": "myTasks",
      "cache": { "kind": "memory", "maxAgeMs": 30000 },
      "entity": "entity.task",
      "filter": {
        "kind": "relationEqualsContext",
        "context": "context.team",
        "relation": "relation.taskTeam"
      },
      "order": [
        {
          "field": "field.task.createdAt",
          "direction": "descending"
        }
      ],
      "select": ["field.task.id", "field.task.title", "field.task.done", "field.task.createdAt"]
    },
    {
      "id": "query.myTeamInvitations",
      "kind": "query",
      "feature": "feature.tasks",
      "name": "myTeamInvitations",
      "cache": { "kind": "memory", "maxAgeMs": 5000 },
      "entity": "entity.teamMembership",
      "filter": {
        "kind": "relationEqualsActor",
        "relation": "relation.membershipMember"
      },
      "where": [{ "field": "field.membership.accepted", "equals": false }],
      "order": [
        {
          "field": "field.membership.createdAt",
          "direction": "descending"
        }
      ],
      "select": [
        "field.membership.id",
        "field.membership.userId",
        "field.membership.role",
        "field.membership.status",
        "field.membership.accepted",
        "field.membership.createdAt"
      ]
    },
    {
      "id": "query.teamInvitations",
      "kind": "query",
      "feature": "feature.tasks",
      "name": "teamInvitations",
      "cache": { "kind": "memory", "maxAgeMs": 5000 },
      "entity": "entity.teamMembership",
      "filter": {
        "kind": "relationEqualsContext",
        "context": "context.ownedTeam",
        "relation": "relation.membershipTeam"
      },
      "order": [
        {
          "field": "field.membership.createdAt",
          "direction": "descending"
        }
      ],
      "select": [
        "field.membership.id",
        "field.membership.userId",
        "field.membership.role",
        "field.membership.status",
        "field.membership.accepted",
        "field.membership.createdAt"
      ]
    }
  ],
