  "verification": {
    "invariants": [
      {
        "id": "invariant.taskOwner",
        "kind": "invariant",
        "statement": "Every new Task belongs to its active Team and records its creator"
      },
      {
        "id": "invariant.ownerAccess",
        "kind": "invariant",
        "statement": "A user can access Tasks only through a server-authorized Team context"
      },
      {
        "id": "invariant.teamAccess",
        "kind": "invariant",
        "statement": "A Team can be selected only by its owner or an active member"
      },
      {
        "id": "invariant.teamInvites",
        "kind": "invariant",
        "statement": "Only a Team owner can invite or revoke a member, and only the invited user can accept"
      },
      {
        "id": "invariant.uniqueTeamMembership",
        "kind": "invariant",
        "statement": "A user can have at most one membership record per Team"
      }
    ],
    "flows": [
      {
        "id": "flow.createTask",
        "kind": "verificationFlow",
        "actor": "authenticatedUser",
        "steps": [
          {
            "kind": "visit",
            "route": "route.tasks"
          },
          {
            "kind": "submit",
            "element": "element.createTaskForm",
            "values": {
              "title": "Test task"
            }
          },
          {
            "kind": "expectQueryContains",
            "query": "query.myTasks",
            "values": {
              "field.task.title": "Test task"
            }
          }
        ]
      },
      {
        "id": "flow.toggleTask",
        "kind": "verificationFlow",
        "actor": "authenticatedUser",
        "steps": [
          {
            "kind": "invoke",
            "operation": "operation.toggleTask"
          },
          {
            "kind": "expectField",
            "field": "field.task.done",
            "value": true
          }
        ]
      },
      {
        "id": "flow.renameTask",
        "kind": "verificationFlow",
        "actor": "authenticatedUser",
        "steps": [
          {
            "kind": "invoke",
            "operation": "operation.renameTask"
          },
          {
            "kind": "expectField",
            "field": "field.task.title",
            "value": "Renamed task"
          }
        ]
      },
      {
        "id": "flow.deleteTask",
        "kind": "verificationFlow",
        "actor": "authenticatedUser",
        "steps": [
          {
            "kind": "invoke",
            "operation": "operation.deleteTask"
          }
        ]
      }
    ]
  }
