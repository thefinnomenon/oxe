{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist-typecheck",
    "paths": {
      "@oxe/compiler": ["../compiler/src/index.ts"],
      "@oxe/graph": ["../graph/src/index.ts"],
      "@oxe/runtime": ["../runtime/src/index.ts"],
      "@oxe/runtime-dom": ["../runtime-dom/src/index.ts"]
    },
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["benchmarks/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "references": [
    { "path": "../compiler" },
    { "path": "../graph" },
    { "path": "../runtime" },
    { "path": "../runtime-dom" }
  ]
}
