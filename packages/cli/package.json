{
  "name": "@oxe/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "oxe": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@oxe/compiler": "workspace:*",
    "@oxe/graph": "workspace:*",
    "@oxe/i18n": "workspace:*",
    "@oxe/router": "workspace:*",
    "@oxe/runtime-server": "workspace:*"
  }
}
