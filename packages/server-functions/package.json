{
  "name": "@oxe/server-functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    },
    "./application-postgres": {
      "types": "./dist/application-postgres.d.ts",
      "import": "./dist/application-postgres.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@oxe/graph": "workspace:*",
    "@oxe/postgres": "workspace:*",
    "@oxe/runtime": "workspace:*"
  },
  "devDependencies": {
    "@oxe/compiler": "workspace:*"
  }
}
