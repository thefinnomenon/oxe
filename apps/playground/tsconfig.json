{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist-typecheck",
    "paths": {
      "@oxe/compiler": ["../../packages/compiler/src/index.ts"],
      "@oxe/graph": ["../../packages/graph/src/index.ts"],
      "@oxe/router": ["../../packages/router/src/index.ts"],
      "@oxe/runtime": ["../../packages/runtime/src/index.ts"],
      "@oxe/runtime-dom": ["../../packages/runtime-dom/src/index.ts"]
    },
    "rootDir": ".",
    "tsBuildInfoFile": "./dist-typecheck/.tsbuildinfo",
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vite.config.ts"],
  "references": [
    { "path": "../../packages/compiler" },
    { "path": "../../packages/graph" },
    { "path": "../../packages/router" },
    { "path": "../../packages/runtime" },
    { "path": "../../packages/runtime-dom" }
  ]
}
